{
  "name": "ChikaBlock",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": {
          "optional": "ServerPackages"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
